# ==============================================================================
# ISOMORPH — Environment Configuration Example
# ==============================================================================
# All variables are optional. When BOB_API_KEY is omitted or DEMO_MODE=true,
# Isomorph runs in deterministic demo mode using cached Bob annotations.
# ==============================================================================

# Server configuration
PORT=3000
HOST=0.0.0.0

# Demo mode (default: true)
DEMO_MODE=true

# IBM Bob 2.0 API configuration (optional for live calls)
# BOB_API_URL=https://api.bob.ibm.com/v1
# BOB_API_KEY=your_ibm_bob_api_key_here
# BOB_MODEL_VERSION=ibm-bob-2.0
