{
  "name": "@isomorph/core",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "node ../../node_modules/jest-cli/bin/jest.js --forceExit",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@isomorph/bob": "*",
    "@isomorph/engine": "*",
    "@isomorph/evidence": "*",
    "@isomorph/proof": "*"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.14",
    "typescript": "^5.4.0"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ],
    "transform": {
      "^.+\\.tsx?$": [
        "ts-jest",
        {
          "tsconfig": "./tsconfig.test.json",
          "diagnostics": {
            "ignoreCodes": ["TS151002"]
          }
        }
      ]
    }
  }
}
